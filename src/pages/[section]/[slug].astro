---
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { SECTIONS, type SectionKey } from '../../consts';

export async function getStaticPaths() {
  const paths = [];
  for (const section of Object.keys(SECTIONS) as SectionKey[]) {
    for (const entry of await getCollection(section)) {
      paths.push({ params: { section, slug: entry.id }, props: { entry, section } });
    }
  }
  return paths;
}

const { entry, section } = Astro.props;
const { Content, headings } = await render(entry);
---

<Post entry={entry} section={section} headings={headings}>
  <Content />
</Post>
