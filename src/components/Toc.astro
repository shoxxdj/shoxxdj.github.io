---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  outline?: [number, number];
  variant: 'aside' | 'inline';
}

const { headings, outline = [1, 3], variant } = Astro.props;

const items = headings.filter((h) => h.depth >= outline[0] && h.depth <= outline[1]);
const base = items.length ? Math.min(...items.map((h) => h.depth)) : 0;
---

{
  items.length > 1 && variant === 'aside' && (
    <nav class="toc" aria-label="Sommaire">
      <h2>Sommaire</h2>
      <ol>
        {items.map((h) => (
          <li class={`l${Math.min(h.depth - base, 2)}`}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

{
  items.length > 1 && variant === 'inline' && (
    <details class="toc-inline">
      <summary>Sommaire</summary>
      <ol>
        {items.map((h) => (
          <li class={`l${Math.min(h.depth - base, 2)}`}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </details>
  )
}
